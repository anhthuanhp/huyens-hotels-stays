"use client";

import Image from "next/image";
import Link from "next/link";
import { usePathname } from "next/navigation";
import { useEffect, useState } from "react";

type Language = "vi" | "en";
type BackLink = { href: string; label: string };

function getBackLink(pathname: string, language: Language): BackLink {
  const segments = pathname.split("/").filter(Boolean);

  if (segments[0] === "khach-san" && segments[2] === "phong") {
    return {
      href: `/khach-san/${segments[1]}`,
      label: language === "vi" ? "Quay lại khách sạn" : "Back to hotel",
    };
  }

  if (segments[0] === "khach-san" && segments[1]) {
    return {
      href: "/#hotels",
      label: language === "vi" ? "Quay về trang chủ" : "Back to home",
    };
  }

  if (segments[0] === "blog" && segments[1]) {
    return {
      href: "/blog",
      label: language === "vi" ? "Quay lại Blog" : "Back to Blog",
    };
  }

  if (segments[0] === "tim-phong" || segments[0] === "dat-phong") {
    return {
      href: "/#booking-search",
      label: language === "vi" ? "Quay lại" : "Go back",
    };
  }

  return {
    href: "/",
    label: language === "vi" ? "Quay về trang chủ" : "Back to home",
  };
}

export default function SiteHeader() {
  const pathname = usePathname() ?? "/";
  const [language, setLanguage] = useState<Language>("vi");

  useEffect(() => {
    const savedLanguage = window.localStorage.getItem("huyen-language");

    if (savedLanguage === "vi" || savedLanguage === "en") {
      setLanguage(savedLanguage);
    }

    const handleLanguageChange = (event: Event) => {
      const customEvent = event as CustomEvent<Language>;
      const nextLanguage = customEvent.detail;

      if (nextLanguage === "vi" || nextLanguage === "en") {
        setLanguage(nextLanguage);
      } else {
        const stored = window.localStorage.getItem("huyen-language");

        if (stored === "vi" || stored === "en") {
          setLanguage(stored);
        }
      }
    };

    window.addEventListener("language-change", handleLanguageChange);

    return () => {
      window.removeEventListener("language-change", handleLanguageChange);
    };
  }, []);

  if (
    pathname === "/" ||
    pathname === "/admin" ||
    pathname.startsWith("/admin/")
  ) {
    return null;
  }

  function changeLanguage(nextLanguage: Language) {
    setLanguage(nextLanguage);
    window.localStorage.setItem("huyen-language", nextLanguage);
    window.dispatchEvent(
      new CustomEvent("language-change", { detail: nextLanguage }),
    );
  }

  const back = getBackLink(pathname, language);

  return (
    <header className="relative z-40 border-b border-slate-200 bg-white">
      <div className="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
        <Link
          href="/"
          aria-label="Huyen's Hotels & Stays"
          className="flex shrink-0 items-center"
        >
          <Image
            src="/images/huyen-hotel-logo-v1.png"
            alt="Huyen's Hotels & Stays"
            width={180}
            height={60}
            priority
            className="h-auto w-[90px] sm:w-[105px] lg:w-[120px]"
          />
        </Link>

        <div className="flex items-center gap-3 sm:gap-5">
          <Link
            href={back.href}
            className="inline-flex min-h-10 items-center gap-2 text-xs font-medium text-slate-600 transition hover:text-slate-950 sm:text-sm"
          >
            <span aria-hidden="true">←</span>
            <span>{back.label}</span>
          </Link>

          <div
            className="flex shrink-0 items-center rounded-full border border-slate-200 bg-slate-50 p-1"
            aria-label="Choose language"
          >
            <button
              type="button"
              onClick={() => changeLanguage("vi")}
              aria-pressed={language === "vi"}
              className={`min-h-8 rounded-full px-3 text-xs font-semibold transition sm:px-4 sm:text-sm ${
                language === "vi"
                  ? "bg-slate-900 text-white shadow-sm"
                  : "text-slate-600 hover:bg-white hover:text-slate-900"
              }`}
            >
              VI
            </button>

            <button
              type="button"
              onClick={() => changeLanguage("en")}
              aria-pressed={language === "en"}
              className={`min-h-8 rounded-full px-3 text-xs font-semibold transition sm:px-4 sm:text-sm ${
                language === "en"
                  ? "bg-slate-900 text-white shadow-sm"
                  : "text-slate-600 hover:bg-white hover:text-slate-900"
              }`}
            >
              EN
            </button>
          </div>
        </div>
      </div>
    </header>
  );
}